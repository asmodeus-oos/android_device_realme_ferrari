<resources>

    <!-- Whether to enable framework dimming for UDFPS -->
    <!-- The panel uses global HBM only (no local HBM). With framework dimming
         enabled, SystemUI composites a full-screen dim layer ("Dim Layer for
         UDFPS") that keeps the area outside the sensor at its current
         brightness while the sensor circle reaches full HBM brightness.
         The LineageOS compositionengine treats it as a regular layer, so no
         panel DIM_LAYER property / HBM is forced on lock/unlock transitions. -->
    <bool name="config_udfpsFrameworkDimming">true</bool>

</resources>

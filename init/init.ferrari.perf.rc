# ferrari: load ZRAM and enable swap for snappier multi-tasking with less
# cold-start battery cost. Module ships in vendor_dlkm but is not in modules.load.

on property:vendor.all.modules.ready=1
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor_dlkm/lib/modules zram

on property:sys.boot_completed=1
    wait /dev/block/zram0 10
    write /sys/block/zram0/comp_algorithm lz4
    swapon_all /vendor/etc/fstab.zram
    # Prefer keeping hot pages in RAM over early ZRAM compress (default 100
    # made light UI work pay decompress cost). Still uses ZRAM under pressure.
    write /proc/sys/vm/swappiness 80

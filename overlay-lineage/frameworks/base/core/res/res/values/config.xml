<resources>
    <!-- 8GB + ZRAM: keep apps warm. 64/96 restarted too often; 1024 with no
         swap thrashed reclaim. 256 is a soft ceiling that still bounds runaway
         empty processes while ZRAM absorbs real memory pressure. -->
    <integer name="config_customizedMaxCachedProcesses">256</integer>
</resources>

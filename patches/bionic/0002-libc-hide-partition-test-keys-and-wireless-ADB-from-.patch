From 2f69d50c9fb622424f5cc2ffedea63e2893e0c3d Mon Sep 17 00:00:00 2001
From: Bubun Das <bubundas17@gmail.com>
Date: Wed, 12 Aug 2026 07:27:33 +0000
Subject: [PATCH 2/2] libc: hide partition test-keys and wireless ADB from apps

Paytm dumps getprop and matches vendor/odm/product build.tags and
fingerprints that still say test-keys/userdebug. Spoof those plus
service.adb.tcp.port for app UIDs.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 libc/bionic/custom_rom_hide.cpp     | 63 ++++++++++++++++++++++++++++-
 libc/bionic/system_property_api.cpp | 19 ++++-----
 2 files changed, 72 insertions(+), 10 deletions(-)

diff --git a/libc/bionic/custom_rom_hide.cpp b/libc/bionic/custom_rom_hide.cpp
index a22397019..cd5d65bcd 100644
--- a/libc/bionic/custom_rom_hide.cpp
+++ b/libc/bionic/custom_rom_hide.cpp
@@ -27,6 +27,7 @@
 #include <sys/stat.h>
 #include <sys/syscall.h>
 #include <sys/sysmacros.h>
+#include <sys/system_properties.h>
 #include <unistd.h>
 #include <private/android_filesystem_config.h>
 
@@ -557,13 +558,58 @@ static const char* const kSpoofedEmptyProps[] = {
     "ro.evolution.version", "ro.evolution.build.version", "ro.evolution.display.version",
     "ro.lineage.version", "ro.lineage.build.version", "ro.cm.build.version",
     "ro.modversion", "init.svc_debug_pid.adb_root", "init.svc_debug_pid.adbd",
-    "init.svc.adb_root", "init.svc.adbd", "service.adb.root", nullptr
+    "init.svc.adb_root", "init.svc.adbd", "service.adb.root",
+    // Paytm probes wireless ADB via SystemProperties + /proc/net/tcp.
+    "service.adb.tcp.port", nullptr
 };
 
 static const char* const kHiddenPropPrefixes[] = {
     "ro.evolution.", "ro.evolutionlegal.", "ro.lineage.", "ro.cm.", nullptr
 };
 
+static bool ends_with(const char* name, const char* suffix) {
+    if (!name || !suffix) return false;
+    size_t nlen = strlen(name);
+    size_t slen = strlen(suffix);
+    return nlen >= slen && strcmp(name + (nlen - slen), suffix) == 0;
+}
+
+static bool is_build_tags_prop(const char* name) {
+    return strcmp(name, "ro.build.tags") == 0 || ends_with(name, ".build.tags");
+}
+
+static bool is_build_type_prop(const char* name) {
+    return strcmp(name, "ro.build.type") == 0 || ends_with(name, ".build.type");
+}
+
+static bool is_fingerprint_prop(const char* name) {
+    return strcmp(name, "ro.build.fingerprint") == 0
+            || ends_with(name, ".build.fingerprint");
+}
+
+static bool rewrite_fingerprint_value(char* value) {
+    if (!value || value[0] == '\0') return false;
+    bool changed = false;
+    char* p;
+    while ((p = strstr(value, "userdebug")) != nullptr) {
+        // "userdebug" (9) -> "user" (4)
+        size_t tail = strlen(p + 9);
+        memmove(p + 4, p + 9, tail + 1);
+        memcpy(p, "user", 4);
+        changed = true;
+    }
+    while ((p = strstr(value, "test-keys")) != nullptr) {
+        // "test-keys" (9) -> "release-keys" (12)
+        size_t head = static_cast<size_t>(p - value);
+        size_t tail = strlen(p + 9);
+        if (head + 12 + tail >= PROP_VALUE_MAX) break;
+        memmove(p + 12, p + 9, tail + 1);
+        memcpy(p, "release-keys", 12);
+        changed = true;
+    }
+    return changed;
+}
+
 static bool is_hidden_prop_name(const char* name) {
     for (const char* const* prop = kSpoofedEmptyProps; *prop; ++prop) {
         if (strcmp(name, *prop) == 0) return true;
@@ -592,6 +638,19 @@ bool custom_rom_hide_should_spoof_prop(const char* name, char* value) {
     for (const PropOverride* o = kSpoofedValueProps; o->name; ++o) {
         if (strcmp(name, o->name) == 0) { strcpy(value, o->value); return true; }
     }
+    // Vendor/odm/product/system_ext/bootimage still ship test-keys; Paytm's
+    // Runtime.exec("getprop") dump matches those lines.
+    if (is_build_tags_prop(name)) {
+        strcpy(value, "release-keys");
+        return true;
+    }
+    if (is_build_type_prop(name)) {
+        strcpy(value, "user");
+        return true;
+    }
+    if (is_fingerprint_prop(name) && rewrite_fingerprint_value(value)) {
+        return true;
+    }
     return false;
 }
 
@@ -607,6 +666,8 @@ const char* custom_rom_hide_get_prop_override(const char* name) {
     for (const PropOverride* o = kSpoofedValueProps; o->name; ++o) {
         if (strcmp(name, o->name) == 0) return o->value;
     }
+    if (is_build_tags_prop(name)) return "release-keys";
+    if (is_build_type_prop(name)) return "user";
     return nullptr;
 }
 
diff --git a/libc/bionic/system_property_api.cpp b/libc/bionic/system_property_api.cpp
index 80f2b381a..eaf542bf0 100644
--- a/libc/bionic/system_property_api.cpp
+++ b/libc/bionic/system_property_api.cpp
@@ -100,28 +100,29 @@ static void read_callback_intercept(void* cookie, const char* name, const char*
 
     bool is_ro = (strncmp(name, "ro.", 3) == 0);
 
-    if (custom_rom_hide_should_hide_prop(name)) {
-        uint32_t fake_serial = is_ro ? 0 : (serial & 0xffffff);
-        ctx->original_callback(ctx->original_cookie, name, "", fake_serial);
-        return;
+    char spoofed[PROP_VALUE_MAX];
+    if (value) {
+        strncpy(spoofed, value, PROP_VALUE_MAX - 1);
+        spoofed[PROP_VALUE_MAX - 1] = '\0';
+    } else {
+        spoofed[0] = '\0';
     }
 
-    const char* override_val = custom_rom_hide_get_prop_override(name);
-    if (override_val) {
-        uint32_t len = strlen(override_val);
+    if (custom_rom_hide_should_spoof_prop(name, spoofed)) {
+        uint32_t len = strlen(spoofed);
         uint32_t fake_serial = serial;
         if (is_ro) {
             fake_serial = (len < PROP_VALUE_MAX) ? (len << 24) : ((50 << 24) | (1 << 16));
         } else {
             fake_serial = (serial & 0xffffff) | (len << 24);
         }
-        ctx->original_callback(ctx->original_cookie, name, override_val, fake_serial);
+        ctx->original_callback(ctx->original_cookie, name, spoofed, fake_serial);
         return;
     }
 
     uint32_t final_serial = serial;
     if (is_ro) {
-        uint32_t len = strlen(value);
+        uint32_t len = strlen(value ? value : "");
         final_serial = (len < PROP_VALUE_MAX) ? (len << 24) : ((50 << 24) | (1 << 16));
     }
 
-- 

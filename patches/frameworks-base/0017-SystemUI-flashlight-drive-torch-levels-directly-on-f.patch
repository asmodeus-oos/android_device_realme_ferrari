From 5ec301366eb2bdceca002a8d6dd3565d40e200d6 Mon Sep 17 00:00:00 2001
From: Bubun Das <bubundas17@gmail.com>
Date: Fri, 7 Aug 2026 07:01:35 +0000
Subject: [PATCH 17/17] SystemUI: flashlight: drive torch levels directly on
 ferrari

The vendor CamX HAL reports FLASH_INFO_STRENGTH_MAXIMUM_LEVEL=1 because
its flash capability query opcode is unimplemented, so the AOSP torch
strength API cannot provide levels. When the HAL reports a single level,
expose our own 4-level range and apply the selected level by writing the
torch current (mA) to the led:torch_0/led:torch_1 brightness sysfs nodes
(the qti flash driver treats LED brightness as current in mA). Torch
on/off still goes through the camera HAL.
---
 .../data/repository/FlashlightRepository.kt   | 95 +++++++++++++++++--
 1 file changed, 86 insertions(+), 9 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/flashlight/data/repository/FlashlightRepository.kt b/packages/SystemUI/src/com/android/systemui/flashlight/data/repository/FlashlightRepository.kt
index c6da6b9bd3be..38864e322da1 100644
--- a/packages/SystemUI/src/com/android/systemui/flashlight/data/repository/FlashlightRepository.kt
+++ b/packages/SystemUI/src/com/android/systemui/flashlight/data/repository/FlashlightRepository.kt
@@ -35,10 +35,12 @@ import com.android.systemui.util.asIndenting
 import com.android.systemui.util.printSection
 import com.android.systemui.util.println
 import com.android.systemui.utils.coroutines.flow.conflatedCallbackFlow
+import java.io.File
 import java.io.PrintWriter
 import java.util.concurrent.ConcurrentHashMap
 import java.util.concurrent.atomic.AtomicBoolean
 import javax.inject.Inject
+import kotlin.time.Duration.Companion.milliseconds
 import kotlin.time.Duration.Companion.seconds
 import kotlinx.coroutines.CoroutineDispatcher
 import kotlinx.coroutines.CoroutineScope
@@ -120,6 +122,15 @@ constructor(
 
     private val defaultEnabledLevelForUser = ConcurrentHashMap<Int, Int>()
 
+    /**
+     * True when the HAL reports no torch strength (FLASH_INFO_STRENGTH_MAXIMUM_LEVEL == 1) and
+     * levels are driven directly through the torch LED sysfs nodes instead (ferrari).
+     */
+    private var directTorchLevels = false
+
+    /** Last level applied through [writeDirectTorchLevel]. */
+    private var lastTorchLevel: Int = BASE_TORCH_LEVEL
+
     override fun start() {
         if (FlashlightStrength.isUnexpectedlyInLegacyMode()) {
             return
@@ -220,8 +231,17 @@ constructor(
 
         if (selectedId != null) {
             val cc = cameraManager.getCameraCharacteristics(selectedId)
-            val default: Int? = cc.get(CameraCharacteristics.FLASH_INFO_STRENGTH_DEFAULT_LEVEL)
-            val max: Int? = cc.get(CameraCharacteristics.FLASH_INFO_STRENGTH_MAXIMUM_LEVEL)
+            var default: Int? = cc.get(CameraCharacteristics.FLASH_INFO_STRENGTH_DEFAULT_LEVEL)
+            var max: Int? = cc.get(CameraCharacteristics.FLASH_INFO_STRENGTH_MAXIMUM_LEVEL)
+            // ferrari: the vendor CamX HAL gates torch strength behind a flash capability
+            // query it does not implement, so it reports a single level. Expose our own
+            // level range and drive the torch LEDs directly through their sysfs nodes.
+            if (max == BASE_TORCH_LEVEL) {
+                default = FERRARI_TORCH_MAX_LEVEL
+                max = FERRARI_TORCH_MAX_LEVEL
+                directTorchLevels = true
+                lastTorchLevel = FERRARI_TORCH_MAX_LEVEL
+            }
             if (default != null) {
                 defaultEnabledLevelForUser[currentUserId] = default
             }
@@ -256,16 +276,22 @@ constructor(
                     if (currentFlashlightInfo is FlashlightInfo.Supported.LoadedSuccessfully)
                         if (camId == currentFlashlightInfo.cameraId) {
                             if (currentFlashlightInfo.hasAdjustableLevels) {
-                                trySend(
-                                    FlashlightModel.Available.Level(
-                                        enabled,
+                                val level =
+                                    if (directTorchLevels) {
+                                        if (enabled) lastTorchLevel else defaultEnabledLevelForUser[currentUserId] ?: initialDefaultLevel
+                                    } else {
                                         if (enabled) {
                                             cameraManager.getTorchStrengthLevel(camId)
                                         } else {
                                             defaultEnabledLevelForUser.getOrPut(currentUserId) {
                                                 initialDefaultLevel
                                             }
-                                        },
+                                        }
+                                    }
+                                trySend(
+                                    FlashlightModel.Available.Level(
+                                        enabled,
+                                        level,
                                         currentFlashlightInfo.maxLevel!!, // b/c hasAdjustableLevels
                                     )
                                 )
@@ -293,7 +319,7 @@ constructor(
                                 trySend(
                                     FlashlightModel.Available.Level(
                                         true, // this callback happens only when enabled
-                                        newStrengthLevel,
+                                        if (directTorchLevels) lastTorchLevel else newStrengthLevel,
                                         currentFlashlightInfo.maxLevel!!, // b/c hasAdjustableLevels
                                     )
                                 )
@@ -393,7 +419,24 @@ constructor(
 
             try {
                 if (enabled != currentState.enabled) {
-                    if (currentFlashlightInfo.hasAdjustableLevels && enabled) {
+                    if (directTorchLevels) {
+                        // The HAL cannot honor torch strength; turn the torch on in binary
+                        // mode (its own default current) and apply the persisted level
+                        // through the LED sysfs nodes once the HAL has settled.
+                        cameraManager.setTorchMode(currentFlashlightInfo.cameraId, enabled)
+                        if (enabled) {
+                            val level = defaultEnabledLevelForUser.getOrPut(currentUserId) {
+                                initialDefaultLevel
+                            }
+                            // Report the intended level right away; the HAL callback carries
+                            // the last applied value which is stale at this point.
+                            lastTorchLevel = level
+                            delay(DIRECT_LEVEL_APPLY_DELAY)
+                            if (flashlightInfo.value is FlashlightInfo.Supported.LoadedSuccessfully) {
+                                writeDirectTorchLevel(level)
+                            }
+                        }
+                    } else if (currentFlashlightInfo.hasAdjustableLevels && enabled) {
                         try {
                             cameraManager.turnOnTorchWithStrengthLevel(
                                 currentFlashlightInfo.cameraId,
@@ -442,7 +485,13 @@ constructor(
 
             try {
                 if (level != currentState.level) {
-                    cameraManager.turnOnTorchWithStrengthLevel(currentInfo.cameraId, level)
+                    if (directTorchLevels) {
+                        if (currentState.enabled) {
+                            writeDirectTorchLevel(level)
+                        }
+                    } else {
+                        cameraManager.turnOnTorchWithStrengthLevel(currentInfo.cameraId, level)
+                    }
                 }
                 if (persist) {
                     defaultEnabledLevelForUser[currentUserId] = level
@@ -473,11 +522,39 @@ constructor(
             (flashlightInfo.value as? FlashlightInfo.Supported.LoadedSuccessfully)?.defaultLevel
                 ?: BASE_TORCH_LEVEL
 
+    /**
+     * Writes a torch current (mA) to the ferrari torch LED sysfs nodes. The qti flash driver
+     * interprets the LED brightness as current in mA, so any value up to the DT limit works.
+     */
+    private fun writeDirectTorchLevel(level: Int) {
+        if (level < 1 || level > FERRARI_TORCH_MAX_LEVEL) return
+        lastTorchLevel = level
+        val currentMa = FERRARI_TORCH_LEVELS_MA[level - 1]
+        for (node in FERRARI_TORCH_NODES) {
+            try {
+                File(node).writeText(currentMa.toString())
+            } catch (e: Exception) {
+                logger.w("Ferrari torch: failed to write $node: ${e.message}")
+            }
+        }
+    }
+
     private val currentUserId: Int
         get() = userRepo.selectedUser.value.userInfo.id
 
     private companion object {
         private const val BASE_TORCH_LEVEL = 1
+
+        // ferrari: level index -> torch current in mA per LED (led:torch_0/led:torch_1).
+        // The HAL's own torch default is 195 mA per LED, matching the top level.
+        private const val FERRARI_TORCH_MAX_LEVEL = 4
+        private val FERRARI_TORCH_LEVELS_MA = intArrayOf(50, 100, 150, 195)
+        private val FERRARI_TORCH_NODES =
+            arrayOf(
+                "/sys/class/leds/led:torch_0/brightness",
+                "/sys/class/leds/led:torch_1/brightness",
+            )
+        private val DIRECT_LEVEL_APPLY_DELAY = 250.milliseconds
         private val RECONNECT_COOLDOWN = 30.seconds
         private val RECONNECT_TIMEOUT = 2.seconds
     }

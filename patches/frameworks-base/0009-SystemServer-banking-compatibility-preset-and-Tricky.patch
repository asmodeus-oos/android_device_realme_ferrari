-            Mode mode = mPackageModes.get(pkg);
-            if (mode == Mode.SKIP) continue;
+            Mode mode = effectiveMode(pkg);
+            if (mode == null || mode == Mode.SKIP) continue;
             if (mode == Mode.GENERATE) return true;
             if (mode == Mode.AUTO && isTeeBroken()) return true;

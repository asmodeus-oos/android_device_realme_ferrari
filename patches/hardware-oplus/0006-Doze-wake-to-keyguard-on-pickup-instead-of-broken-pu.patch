From 050f71d8af9b50002e80b0779bad2720f44fb704 Mon Sep 17 00:00:00 2001
From: Bubun Das <bubundas17@gmail.com>
Date: Wed, 12 Aug 2026 16:06:09 +0000
Subject: [PATCH 6/6] Doze: wake to keyguard on pickup instead of broken pulse

Pickup gestures only run while AOD is off; doze pulse then often shows
a dim wallpaper-only frame without clock or UDFPS icon. Always wake the
interactive lockscreen so both are visible.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 .../lineageos/settings/doze/PickupSensor.kt   | 22 +++++++++----------
 1 file changed, 11 insertions(+), 11 deletions(-)

diff --git a/packages/Doze/src/org/lineageos/settings/doze/PickupSensor.kt b/packages/Doze/src/org/lineageos/settings/doze/PickupSensor.kt
index 6754815..d33bab7 100644
--- a/packages/Doze/src/org/lineageos/settings/doze/PickupSensor.kt
+++ b/packages/Doze/src/org/lineageos/settings/doze/PickupSensor.kt
@@ -38,17 +38,17 @@ class PickupSensor(
         }
         entryTimestamp = SystemClock.elapsedRealtime()
         if (event.values[0] == sensorValue) {
-            if (Utils.isPickUpSetToWake(context)) {
-                wakeLock.acquire(WAKELOCK_TIMEOUT_MS)
-                powerManager.wakeUpWithProximityCheck(
-                    SystemClock.uptimeMillis(),
-                    PowerManager.WAKE_REASON_GESTURE,
-                    TAG,
-                    Display.DEFAULT_DISPLAY,
-                )
-            } else {
-                Utils.launchDozePulse(context)
-            }
+            // This doze service only runs while Always-on is OFF. A doze pulse
+            // then often leaves a dim wallpaper-only frame (no clock / UDFPS
+            // icon) on Oplus panels. Always wake to the interactive keyguard
+            // so clock + fingerprint affordance are visible; FP still works.
+            wakeLock.acquire(WAKELOCK_TIMEOUT_MS)
+            powerManager.wakeUpWithProximityCheck(
+                SystemClock.uptimeMillis(),
+                PowerManager.WAKE_REASON_GESTURE,
+                TAG,
+                Display.DEFAULT_DISPLAY,
+            )
         }
     }
 

From 2ac9fdfc8dc083e8bb30e6fdbba2d46b03dcbe7a Mon Sep 17 00:00:00 2001
From: Bubun Das <bubundas17@gmail.com>
Date: Mon, 10 Aug 2026 10:11:36 +0000
Subject: [PATCH 3/6] fingerprint: avoid full-screen HBM flash on ferrari

---
 hidl/fingerprint/BiometricsFingerprint.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/hidl/fingerprint/BiometricsFingerprint.cpp b/hidl/fingerprint/BiometricsFingerprint.cpp
index 6ce2b69..7dce389 100644
--- a/hidl/fingerprint/BiometricsFingerprint.cpp
+++ b/hidl/fingerprint/BiometricsFingerprint.cpp
@@ -75,7 +75,11 @@ Return<RequestStatus> BiometricsFingerprint::setActiveGroup(uint32_t gid,
 }
 
 Return<RequestStatus> BiometricsFingerprint::authenticate(uint64_t operationId, uint32_t gid) {
-    setDimlayerHbm(1);
+    // The ferrari panel driver owns the optical FOD highlight.  Enabling the
+    // legacy dim-layer HBM ioctl here drives the entire panel into HBM, which
+    // appears as a full-screen brightness flash during fingerprint unlock.
+    // Keep the framework dimming overlay disabled and let onFingerDown() only
+    // assert the localized fingerprint press state.
     return mOplusBiometricsFingerprint->authenticate(operationId, gid);
 }
 

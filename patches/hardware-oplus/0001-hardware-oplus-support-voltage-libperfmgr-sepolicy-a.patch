From 48cf1b8ddbdc8d9c22ae1844ff66ee3f646ebd62 Mon Sep 17 00:00:00 2001
From: asmodeus-oos <mohamed20020093@gmail.com>
Date: Sun, 30 Aug 2026 20:10:47 +0000
Subject: [PATCH] hardware-oplus: support voltage libperfmgr sepolicy and add
 gnss aidl to matrix

---
 sepolicy/qti/SEPolicy.mk          | 3 ++-
 vintf/device_framework_matrix.xml | 8 ++++++++
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/sepolicy/qti/SEPolicy.mk b/sepolicy/qti/SEPolicy.mk
index 8ab3d0b..1779e2b 100644
--- a/sepolicy/qti/SEPolicy.mk
+++ b/sepolicy/qti/SEPolicy.mk
@@ -29,4 +29,5 @@ SYSTEM_EXT_PUBLIC_SEPOLICY_DIRS += \
     hardware/oplus/sepolicy/qti/public/common-um
 endif
 
-include device/lineage/sepolicy/libperfmgr/sepolicy.mk
+-include device/lineage/sepolicy/libperfmgr/sepolicy.mk
+-include device/voltage/sepolicy/libperfmgr/sepolicy.mk
diff --git a/vintf/device_framework_matrix.xml b/vintf/device_framework_matrix.xml
index bb6785a..d154078 100644
--- a/vintf/device_framework_matrix.xml
+++ b/vintf/device_framework_matrix.xml
@@ -1,4 +1,12 @@
 <compatibility-matrix version="4.0" type="framework">
+    <hal format="aidl" optional="true">
+        <name>android.hardware.gnss</name>
+        <version>1-3</version>
+        <interface>
+            <name>IGnss</name>
+            <instance>default</instance>
+        </interface>
+    </hal>
     <hal format="aidl" optional="true">
         <name>vendor.oplus.hardware.appradioaidl</name>
         <version>1</version>
-- 
2.43.0

